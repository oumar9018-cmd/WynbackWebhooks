# wynback-ingest — environment template (PLACEHOLDERS ONLY, never real secrets)
# Copy to .env and fill in. .env is git-ignored; this file is safe to commit.

PORT=3000
FIRESTORE_MODE=memory
# Firestore mode: exactly ONE of the two below. On Render, use the
# JSON env var (no secret file on the host). See SERVICE_ACCOUNT.md.
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/dedicated-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Shopify: shop domain -> owner workspace + shared secret
# SHOPIFY_SECRETS_JSON={"example.myshopify.com":{"ownerUid":"OWNER_UID","secret":"SHOPIFY_SHARED_SECRET"}}

# Meta: page id -> owner workspace + page token + app secret
# META_PAGES_JSON={"123456789":{"ownerUid":"OWNER_UID","pageToken":"PAGE_TOKEN","appSecret":"APP_SECRET"}}
# Token entered in the Meta app dashboard for the webhook verification handshake:
# META_VERIFY_TOKEN=choose-a-long-random-string

# IndiaMART: key id -> owner workspace + key
# INDIAMART_KEYS_JSON={"owner-a":{"ownerUid":"OWNER_UID","key":"IM_API_KEY"}}

# Website: owner workspace -> sha256 HEX of the bearer token (never the raw token)
# Generate: node -e "console.log(require('crypto').createHash('sha256').update('TOKEN').digest('hex'))"
# WEBSITE_TOKENS_JSON={"OWNER_UID":"<64-hex-chars>"}

# Outbound subscriptions (optional): signed POSTs on inquiry.created
# OUTBOUND_SUBSCRIPTIONS_JSON=[{"id":"crm-1","ownerUid":"OWNER_UID","url":"https://example.com/hook","secret":"SHARED_SECRET","branchId":""}]

# Admin key for /ops/* endpoints (optional; unset => /ops/* returns 404)
# ADMIN_KEY=choose-a-long-random-string

RATE_LIMIT_PER_MINUTE=100
MAX_BODY_BYTES=1048576
WATCHER_POLL_MS=15000
